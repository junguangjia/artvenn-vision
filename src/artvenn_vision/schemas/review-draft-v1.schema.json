{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:artvenn:vision:review-draft:v1",
  "title": "ArtVenn Vision complete review draft v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objects",
    "photos"
  ],
  "properties": {
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "photos": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/photo"
      }
    }
  },
  "$defs": {
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "title",
        "asset_ids"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "title": {
          "type": "string",
          "maxLength": 1200
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
          },
          "uniqueItems": true
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "front": {
              "enum": [
                "captured",
                "not_captured",
                "unknown",
                "verified_absent",
                null
              ]
            },
            "back": {
              "enum": [
                "captured",
                "not_captured",
                "unknown",
                "verified_absent",
                null
              ]
            },
            "left": {
              "enum": [
                "captured",
                "not_captured",
                "unknown",
                "verified_absent",
                null
              ]
            },
            "right": {
              "enum": [
                "captured",
                "not_captured",
                "unknown",
                "verified_absent",
                null
              ]
            },
            "head": {
              "enum": [
                "captured",
                "not_captured",
                "unknown",
                "verified_absent",
                null
              ]
            },
            "body": {
              "enum": [
                "captured",
                "not_captured",
                "unknown",
                "verified_absent",
                null
              ]
            },
            "base": {
              "enum": [
                "captured",
                "not_captured",
                "unknown",
                "verified_absent",
                null
              ]
            },
            "main_work": {
              "enum": [
                "captured",
                "not_captured",
                "unknown",
                "verified_absent",
                null
              ]
            },
            "frontispiece": {
              "enum": [
                "captured",
                "not_captured",
                "unknown",
                "verified_absent",
                null
              ]
            },
            "tail": {
              "enum": [
                "captured",
                "not_captured",
                "unknown",
                "verified_absent",
                null
              ]
            },
            "cover_mount": {
              "enum": [
                "captured",
                "not_captured",
                "unknown",
                "verified_absent",
                null
              ]
            },
            "leaf_page": {
              "enum": [
                "captured",
                "not_captured",
                "unknown",
                "verified_absent",
                null
              ]
            },
            "coverage_evidence": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1000
            }
          }
        }
      }
    },
    "photo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "role",
        "labels"
      ],
      "properties": {
        "object_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "context",
            "detail",
            "label",
            "overview",
            "unspecified"
          ]
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "object_kind": {
              "enum": [
                "inscription",
                "calligraphy",
                "unknown",
                null
              ]
            },
            "representation": {
              "enum": [
                "stone",
                "ink_original",
                "rubbing",
                "facsimile",
                "unknown",
                null
              ]
            },
            "capture_method": {
              "enum": [
                "photo",
                "scan",
                "unknown",
                null
              ]
            },
            "coverage": {
              "enum": [
                "whole_object",
                "whole_surface_page",
                "detail",
                "context",
                "label",
                "unknown",
                null
              ]
            },
            "surfaces": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "front",
                  "back",
                  "side_unspecified",
                  "left",
                  "right",
                  "other",
                  "unknown",
                  "not_applicable"
                ]
              },
              "maxItems": 8
            },
            "side_reference": {
              "enum": [
                "facing_front",
                "unknown",
                "not_applicable",
                null
              ]
            },
            "parts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "head",
                  "body",
                  "base",
                  "other",
                  "unknown",
                  "not_applicable"
                ]
              },
              "maxItems": 6
            },
            "work_format": {
              "enum": [
                "handscroll",
                "album",
                "folded_book",
                "hanging_scroll",
                "other",
                "unknown",
                "not_applicable",
                null
              ]
            },
            "positions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "main_work",
                  "frontispiece",
                  "tail",
                  "cover_mount",
                  "leaf_page",
                  "other",
                  "unknown",
                  "not_applicable"
                ]
              },
              "maxItems": 8
            },
            "content": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "main_text",
                  "stele_title",
                  "title",
                  "colophon",
                  "title_slip",
                  "signature",
                  "seal",
                  "ornament",
                  "damage",
                  "label",
                  "unknown"
                ]
              },
              "maxItems": 11
            },
            "version_label": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 120
            },
            "position_index": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "notes": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1000
            }
          }
        }
      }
    }
  }
}
